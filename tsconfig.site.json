{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": false,
    "outDir": "site/dist",
    "rootDir": ".",
    "types": []
  },
  "include": ["lib/**/*.ts", "site/src/**/*.ts"]
}
